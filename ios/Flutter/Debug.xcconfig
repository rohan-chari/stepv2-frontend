#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Generated.xcconfig is regenerated by Flutter and may exclude arm64 from
// simulator builds. Keep Apple Silicon simulators buildable in local debug
// builds by overriding that generated setting afterwards.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386
