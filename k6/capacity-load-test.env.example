BASE_URL=https://staging.steptracker-api.org
USERS_FILE=./users.json
CLIENT_COHORT=ios_bara_2_3_7_ads_payout
TARGET_RUNG=rate_15rps
SUMMARY_JSON=/tmp/capacity-summary.json
RUN_ID=replace-with-unique-run-id
REPEAT_INDEX=1

# Required evidence labels for a measured cohort. Replace every placeholder;
# the aggregator rejects placeholder revisions and malformed topology labels.
BACKEND_REVISION=replace-me
BACKEND_FLAGS=all-capacity-flags-off
BACKEND_CONFIG=capacity-phase-metrics-v1-query-capture-on
WORKER_COUNT=1
PGBOUNCER_POOL=3
REDIS_STATE=warm-process-warm-redis
CRON_COHORT=warm-steady-outside-heavy-tick
